# Goal
tobas_msgs/CommandLevel level
float64 target_altitude  # [m]
float64 duration         # [s]
float64 timeout          # [s] By default, timeout is infinite.

---

# Result
int8 error_code
int8 NO_ERROR = 0
int8 NOT_READY = -1
int8 INVALID_GOAL = -2
int8 PREEMPTED = -3
int8 TIMEOUT = -4
int8 UNKNOWN_ERROR = -5

---

