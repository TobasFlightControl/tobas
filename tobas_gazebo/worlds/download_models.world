<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">

    <!-- Available models: http://models.gazebosim.org/ -->
    <!-- How to contribute a model: https://classic.gazebosim.org/tutorials?tut=model_contrib -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://coke_can</uri>
    </include>

    <include>
      <uri>model://table</uri>
    </include>

  </world>
</sdf>
