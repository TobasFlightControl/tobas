std_msgs/Header header
float64 rotation_speed                  # Rotation speed [rad/s]
float64 current                         # Current [A]
float64 rotor_noise                     # Noise at specific frequencies generated by rotor rotation [N]
geometry_msgs/Vector3 thrust_force      # Thrust force in world frame [N]
geometry_msgs/Vector3 horizontal_force  # Horizontal force in world frame [N]
geometry_msgs/Vector3 drag_torque       # Rotor drag torque in body frame [Nm]
