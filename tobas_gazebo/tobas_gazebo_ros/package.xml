<?xml version="1.0"?>
<package format="3">

	<name>tobas_gazebo_ros</name>
	<version>0.0.0</version>
	<description>TODO</description>
	<maintainer email="masa0u0masa1215@gmail.com">Masayoshi Dohi</maintainer>
	<license>TODO</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<exec_depend>ros_control</exec_depend>
	<exec_depend>ros_controllers</exec_depend>

	<depend>tobas_gazebo_common</depend>
	<depend>tobas_gazebo_msgs</depend>
	<depend>tobas_tools</depend>

	<!-- Make gazebo look in the package directory for models -->
	<!-- https://qiita.com/srs/items/ac242e46177c2b797a7b -->
	<exec_depend>gazebo_ros</exec_depend>
	<export>
		<gazebo_ros gazebo_model_path="${prefix}/models"/>
		<gazebo_ros gazebo_media_path="${prefix}/models"/>
	</export>

	<export>
		<build_type>ament_cmake</build_type>
	</export>

</package>
