<launch>

  <arg name="nodelet" default="true"/>
  <arg name="nodelet_manager" default="true"/>

  <group if="$(arg nodelet)">
    <node if="$(arg nodelet_manager)" pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager" output="screen"/>
    <node pkg="nodelet" type="nodelet" name="static_state_determination_server" args="load tobas_common_actions/StaticStateDeterminationServerNodelet nodelet_manager" output="screen"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_common_actions" type="static_state_determination_server_node" name="static_state_determination_server" output="screen"/>
  </group>

</launch>
