<launch>

  <arg name="nodelet" default="false"/>

  <arg name="node_name" value="wait_for_stillness_server"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_common_actions/WaitForStillnessServerNodelet nodelet_manager" output="screen" required="true"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_common_actions" type="wait_for_stillness_server_node" name="$(arg node_name)" output="screen" required="true"/>
  </group>

</launch>
