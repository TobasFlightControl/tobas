<launch>



  <arg name="sbus_name" value="a1_sbus_driver"/>

  <node if="$(arg nodelet)" pkg="nodelet" exec="nodelet" name="$(arg sbus_name)" args="load tobas_a1_ros/SBUSDriverNodelet nodelet_manager_high" output="screen"/>
  <node unless="$(arg nodelet)" pkg="tobas_a1_ros" exec="sbus_driver_node" name="$(arg sbus_name)" output="screen"/>

</launch>
