<launch>

  <arg name="nodelet" default="false"/>

  <arg name="imu_name" value="navio_imu_handler"/>
  <arg name="mag_name" value="navio_magnetometer_handler"/>
  <arg name="bar_name" value="navio_barometer_handler"/>
  <arg name="gps_name" value="navio_gps_handler"/>
  <arg name="bat_name" value="navio_battery_handler"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg imu_name)" args="load tobas_navio_ros/ImuHandlerNodelet nodelet_manager_high" output="screen" required="true"/>
    <node pkg="nodelet" type="nodelet" name="$(arg mag_name)" args="load tobas_navio_ros/MagnetometerHandlerNodelet nodelet_manager_medium" output="screen" required="true"/>
    <node pkg="nodelet" type="nodelet" name="$(arg bar_name)" args="load tobas_navio_ros/BarometerHandlerNodelet nodelet_manager_medium" output="screen" required="true"/>
    <node pkg="nodelet" type="nodelet" name="$(arg gps_name)" args="load tobas_navio_ros/GpsHandlerNodelet nodelet_manager_medium" output="screen" required="true"/>
    <node pkg="nodelet" type="nodelet" name="$(arg bat_name)" args="load tobas_navio_ros/BatteryHandlerNodelet nodelet_manager_medium" output="screen" required="true"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_navio_ros" type="imu_handler_node" name="$(arg imu_name)" output="screen" required="true"/>
    <node pkg="tobas_navio_ros" type="magnetometer_handler_node" name="$(arg mag_name)" output="screen" required="true"/>
    <node pkg="tobas_navio_ros" type="barometer_handler_node" name="$(arg bar_name)" output="screen" required="true"/>
    <node pkg="tobas_navio_ros" type="gps_handler_node" name="$(arg gps_name)" output="screen" required="true"/>
    <node pkg="tobas_navio_ros" type="battery_handler_node" name="$(arg bat_name)" output="screen" required="true"/>
  </group>

</launch>
