<launch>

  <arg name="control_mode" default="position"/>

  <!-- Load environment configurations from YAML file to parameter server -->
  <rosparam file="$(find {{ pkg_name }})/config/environment.yaml" command="load"/>

  <group ns="{{ drone_name }}">
    <!-- Bringup controller -->
    <rosparam file="$(find {{ pkg_name }})/config/controller.yaml" command="load"/>
    <group if="$(eval control_mode=='position')">
      <include file="$(find {{ controller_pkg }})/launch/position_control.launch"/>
    </group>
    <group if="$(eval control_mode=='velocity')">
      <include file="$(find {{ controller_pkg }})/launch/velocity_control.launch"/>
    </group>

    <!-- Bringup observer -->
    <rosparam file="$(find {{ pkg_name }})/config/observer.yaml" command="load"/>
    <include file="$(find {{ observer_pkg }})/launch/observer.launch"/>

    <!-- Bringup static state determinator -->
    <include file="$(find static_state_determination)/launch/static_state_determination.launch"/>
  </group>

</launch>
