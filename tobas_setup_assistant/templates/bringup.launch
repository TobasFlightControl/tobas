<launch>

  <arg name="control_mode" default="position"/>

  <!-- Bringup controller -->
  <include file="$(find {{ pkg_name }})/launch/controller.launch">
    <arg name="control_mode" value="$(arg control_mode)"/>
  </include>

  <!-- Bringup observer -->
  <include file="$(find {{ pkg_name }})/launch/observer.launch"/>

</launch>
