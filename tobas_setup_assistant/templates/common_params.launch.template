<launch>

  <arg name="user_debug" default="false"/>

  <group ns="{{ drone_name }}">
    <!-- Load drone configurations from TBSF file to parameter server -->
    <rosparam file="$(find {{ pkg_name }})/config/drone.tbsf" command="load"/>

    <!-- Load the URDF into the ROS parameter server -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find {{ pkg_name }})/urdf/{{ drone_name }}.xacro' DEBUG:=$(arg user_debug)"/>
  </group>

</launch>
