<launch>

  <arg name="ground_truth" default="false"/>

  <group ns="{{ drone_name }}">
    <node pkg="tobas_keyboard_teleop" type="position_yaw_publisher_node" name="keyboard_teleop" output="screen">
      <remap if="$(arg ground_truth)" from="pose_twist" to="ground_truth/pose_twist"/>
    </node>
  </group>

</launch>
