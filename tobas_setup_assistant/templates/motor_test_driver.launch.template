<launch>

  <!-- Load common parameters -->
  <include file="$(find {{ pkg_name }})/launch/common_params.launch"/>

  <!-- Launch driver nodes necessary for the motor test -->
  <group ns="{{ drone_name }}">
    <include file="$(find tobas_real)/launch/motors.launch">
      <arg name="nodelet" value="false"/>
      <arg name="block_below_arm_speed" value="false"/>
    </include>
  </group>

</launch>
