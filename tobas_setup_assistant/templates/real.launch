<launch>

  <arg name="nodelet" default="true"/>
  <arg name="delay" default="5"/>

  <!-- Launch nodelet manager -->
  <include if="$(arg nodelet)" file="$(find {{ pkg_name }})/launch/nodelet_manager.launch"/>

  <!-- Load environment configurations from YAML file to parameter server -->
  <rosparam file="$(find {{ pkg_name }})/config/environment.yaml" command="load"/>

  <group ns="{{ drone_name }}">
    <!-- Load drone configurations from TBSF file to parameter server -->
    <rosparam file="$(find {{ pkg_name }})/config/{{ drone_name }}.tbsf" command="load"/>

    <!-- Load the URDF into the ROS parameter server -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find {{ pkg_name }})/urdf/{{ drone_name }}.xacro' DEBUG:=false"/>

    <!-- Bringup the nodes required for connections between hardware and software -->
    <include file="$(find tobas_real)/launch/hardware_interfaces.launch">
      <arg name="nodelet" value="$(arg nodelet)"/>
      <arg name="delay" value="$(arg delay)"/>
    </include>
  </group>

  <!-- Bringup Tobas software -->
  <include file="$(find {{ pkg_name }})/launch/bringup.launch">
    <arg name="nodelet" value="$(arg nodelet)"/>
    <arg name="delay" value="$(arg delay)"/>
  </include>

</launch>
