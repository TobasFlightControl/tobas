<launch>

  <arg name="world_path" default="$(find-pkg-share tobas_gazebo_sim)/worlds/empty.world"/>
  <arg name="headless" default="false"/>
  <arg name="verbose" default="3"/>

  <!-- cf. `$ gz sim -h` -->
  <group if="$(var headless)">
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="$(var world_path) -r -s -v $(var verbose)"/>
    </include>
  </group>
  <group unless="$(var headless)">
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="$(var world_path) -r -v $(var verbose)"/>
    </include>
  </group>

  <!-- Bridge communication between ROS and Gazebo: https://docs.ros.org/en/jazzy/p/ros_gz_bridge/#example-6-configuring-the-bridge-via-xml-launch-file -->
  <ros_gz_bridge bridge_name="clock_bridge">
    <topic ros_topic_name="/clock" gz_topic_name="/clock" ros_type_name="rosgraph_msgs/msg/Clock" gz_type_name="gz.msgs.Clock" lazy="False" direction="GZ_TO_ROS" qos_profile="CLOCK"/>
  </ros_gz_bridge>

</launch>
