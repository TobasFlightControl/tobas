<sdf version="1.10">
  <model name="ground_plane">

    <static>true</static>

    <link name="link">

      <collision name="collision">

        <!-- Limiting the maximum number of contact points improves computation speed but reduces accuracy. -->
        <!-- <max_contacts>4</max_contacts> -->

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>

        <surface>
          <!-- <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction> -->
          <contact>
            <ode>
              <!-- This strongly stabilizes contact points, but needs fine tuning. Set roughly to critical damping. -->
              <!-- <kp>2.5e+5</kp>
              <kd>1e+3</kd> -->

              <!-- The following four parameters may contribute little to contact-point stabilization. -->
              <!-- <max_vel>10.0</max_vel>
              <min_depth>0.001</min_depth>
              <soft_cfm>1e-3</soft_cfm>
              <soft_erp>0.1</soft_erp> -->
            </ode>
          </contact>
        </surface>

      </collision>

      <visual name="visual">

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>

        <material>
          <script>
            <!-- Since `gz_sim_vendor/share/gz/gz-sim8` is added to the path by dsv, this can be imported by relative path. -->
            <uri>media/gazebo.material</uri>
            <name>Gazebo/Gray</name>
          </script>
        </material>

      </visual>

    </link>

  </model>
</sdf>
