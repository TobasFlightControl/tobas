<package format="3">

	<name>tobas_ssh_server</name>
	<version>2.17.0</version>
	<description>ROS 2 server that exposes remote command execution and file transfer over SSH.</description>
	<maintainer email="m.dohi@tobas.jp">Masayoshi Dohi</maintainer>
	<license>GPL-3.0-or-later</license>

	<exec_depend>python3-paramiko</exec_depend>
	<exec_depend>python3-scp</exec_depend>
	<exec_depend>rclpy</exec_depend>
	<exec_depend>tobas_ssh_msgs</exec_depend>

	<export>
		<build_type>ament_python</build_type>
	</export>

</package>
