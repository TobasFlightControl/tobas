# Do not delete or rename this file because it is executed in {{ config_pkg_name }}/real.launch.py.

from launch import LaunchDescription
from launch_ros.actions import LoadComposableNodes
from launch_ros.descriptions import ComposableNode


def generate_launch_description():
    ld = LaunchDescription()

    # Launch Tobas bridge
    ld.add_action(
        LoadComposableNodes(
            target_container="{{ drone_name }}/component_manager_medium",
            composable_node_descriptions=[
                ComposableNode(
                    package="{{ user_pkg_name }}",
                    plugin="TobasBridgeNode",
                    namespace="{{ drone_name }}",
                    extra_arguments=[{"use_intra_process_comms": True}],
                ),
            ],
        )
    )

    # Please add the nodes that run only on the actual machine.

    return ld
