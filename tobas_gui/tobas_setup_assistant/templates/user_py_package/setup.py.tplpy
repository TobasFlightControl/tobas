import os
from glob import glob
from typing import List
from setuptools import setup, find_packages


def package_files(directory: str, data_files: List[str]) -> List[str]:
    for path, _, filenames in os.walk(directory):
        for _ in filenames:
            data_files.append((f"share/{{ user_py_pkg_name }}/{path}", glob(path + "/**/*.*", recursive=True)))
    return data_files


data_files = []
data_files.append(("share/ament_index/resource_index/packages", ["resource/{{ user_py_pkg_name }}"]))
data_files.append(("share/{{ user_py_pkg_name }}", ["package.xml"]))
data_files = package_files("launch/", data_files)

console_scripts = [
    "user_node = {{ user_py_pkg_name }}.user_node:main",
    # Add executable Python scripts here
]

setup(
    name="{{ user_py_pkg_name }}",
    version="0.0.0",
    packages=find_packages(),
    data_files=data_files,
    install_requires=["setuptools"],
    zip_safe=True,
    maintainer="{{ author_name }}",
    maintainer_email="{{ author_email }}",
    description="Tobas user Python package for {{ drone_name }}",
    license="BSD",
    tests_require=["pytest"],
    entry_points={"console_scripts": console_scripts},
)
