<?xml version="1.0"?>
<package format="3">

	<name>{{ user_py_pkg_name }}</name>
	<version>0.0.0</version>
	<description>Tobas user Python package for {{ drone_name }}</description>
	<maintainer email="{{ author_email }}">{{ author_name }}</maintainer>
	<license>BSD</license>

	<export>
		<build_type>ament_python</build_type>
	</export>

</package>
