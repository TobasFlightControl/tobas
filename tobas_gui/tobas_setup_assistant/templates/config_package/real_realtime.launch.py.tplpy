from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, GroupAction
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution, Command, FindExecutable
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import LoadComposableNodes, PushRosNamespace
from launch_ros.descriptions import ComposableNode
from launch_ros.substitutions import FindPackageShare

# Template parameters
DRONE_NAME = "{{ drone_name }}"
CONFIG_PKG_NAME = "{{ config_pkg_name }}"
USER_CPP_PKG_NAME = "{{ user_cpp_pkg_name }}"
HARDWARE_PKG = "{{ hardware_pkg }}"

# Arguments
LOG_LEVEL = "log_level"
OUTPUT = "output"
MULTIPROCESS = "multiprocess"
ID = "id"


def generate_launch_description():
    ld = LaunchDescription()

    # Declare arguments
    ld.add_action(DeclareLaunchArgument(LOG_LEVEL, default_value="info"))
    ld.add_action(DeclareLaunchArgument(OUTPUT, default_value="screen"))
    ld.add_action(DeclareLaunchArgument(MULTIPROCESS, default_value="false"))
    ld.add_action(DeclareLaunchArgument(ID, default_value="id0"))

    # Get arguments
    log_level = LaunchConfiguration(LOG_LEVEL)
    output = LaunchConfiguration(OUTPUT)
    multiprocess = LaunchConfiguration(MULTIPROCESS)
    id = LaunchConfiguration(ID)

    namespace = PathJoinSubstitution([DRONE_NAME, id])
    config_pkg_share = FindPackageShare(CONFIG_PKG_NAME)
    user_cpp_pkg_share = FindPackageShare(USER_CPP_PKG_NAME)
    hw_pkg_share = FindPackageShare(HARDWARE_PKG)

    # Parse URDF
    xacro_path = PathJoinSubstitution([FindPackageShare(CONFIG_PKG_NAME), "urdf", "drone.xacro"])
    urdf_text = Command([FindExecutable(name="xacro"), " ", xacro_path, " DEBUG:=false ID:=", id])

    # Launch Tobas core software
    # To ensure stable registration of components, the component managers are launched first.
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                PathJoinSubstitution([config_pkg_share, "launch", "common_realtime_component.launch.py"])
            ),
            launch_arguments={
                "log_level": log_level,
                "output": output,
                "use_sim_time": "false",
                "ground_truth": "false",
                "multiprocess": multiprocess,
                "id": id,
            }.items(),
        )
    )

    # Launch hardware interfaces
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                PathJoinSubstitution([hw_pkg_share, "launch", "hardware_interfaces.launch.py"])
            ),
            launch_arguments={"namespace": namespace}.items(),
        )
    )

    # Launch 1st priority nodes (Twist Control)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_1"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::ImuHandlerNode",
                    namespace=namespace,
                    parameters=[{"section": DRONE_NAME}],
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::IcePropulsionSystemHandlerNode",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch 2nd priority nodes (Pose Control & Navigation & Manipulation)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_2"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="robot_state_publisher",
                    plugin="robot_state_publisher::RobotStatePublisher",
                    namespace=namespace,
                    parameters=[{"robot_description": urdf_text}],
                    remappings=[("/tf", "tf"), ("/tf_static", "tf_static")],
                ),
                ComposableNode(
                    package="tobas_sbus_driver",
                    plugin="tobas::SbusDriverNode",
                    namespace=namespace,
                    parameters=[{"device": "/dev/ttyAMA0"}],  # TODO: Change the device according to the FMU.
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::RCInputHandlerNode",
                    namespace=namespace,
                    parameters=[{"section": DRONE_NAME}],
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::MagnetometerHandlerNode",
                    namespace=namespace,
                    parameters=[{"section": DRONE_NAME}],
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::JointsHandlerNode",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch 3th priority nodes (Others)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_3"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="tobas::real::CpuHandlerNode",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch user nodes
    ld.add_action(
        GroupAction(
            [
                PushRosNamespace(namespace),
                IncludeLaunchDescription(
                    PythonLaunchDescriptionSource(
                        PathJoinSubstitution([user_cpp_pkg_share, "launch", "real_realtime.launch.py"])
                    )
                ),
            ]
        )
    )

    return ld
