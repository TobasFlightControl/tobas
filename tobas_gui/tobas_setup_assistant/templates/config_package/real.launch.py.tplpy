from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, GroupAction
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch.launch_description_sources import PythonLaunchDescriptionSource

from launch_ros.actions import LoadComposableNodes, PushROSNamespace
from launch_ros.descriptions import ComposableNode
from launch_ros.substitutions import FindPackageShare

# Template parameters
DRONE_NAME = "{{ drone_name }}"
CONFIG_PKG_NAME = "{{ config_pkg_name }}"
USER_PKG_NAME = "{{ user_pkg_name }}"
HARDWARE_PKG = "{{ hardware_pkg }}"

# Arguments
LOG_LEVEL = "log_level"
OUTPUT = "output"


def generate_launch_description():
    ld = LaunchDescription()

    # Declare arguments
    ld.add_action(DeclareLaunchArgument(LOG_LEVEL, default_value="info"))
    ld.add_action(DeclareLaunchArgument(OUTPUT, default_value="screen"))

    # Get arguments
    log_level = LaunchConfiguration(LOG_LEVEL)
    output = LaunchConfiguration(OUTPUT)

    config_pkg_share = FindPackageShare(CONFIG_PKG_NAME)
    user_pkg_share = FindPackageShare(USER_PKG_NAME)
    hw_pkg_share = FindPackageShare(HARDWARE_PKG)
    extra_arguments = [{"use_intra_process_comms": True}]

    # ========== namespace {{ drone_name }} ==========
    drone_ns = []
    drone_ns.append(PushROSNamespace(DRONE_NAME))

    # Launch hardware interfaces
    drone_ns.append(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                [PathJoinSubstitution([hw_pkg_share, "launch", "hardware_interfaces.launch.py"])]
            )
        )
    )

    # Launch high priority nodes
    drone_ns.append(
        LoadComposableNodes(
            target_container="component_manager_high",
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="ImuHandlerNode",
                    extra_arguments=extra_arguments,
                ),
            ],
        )
    )

    # Launch medium priority nodes
    drone_ns.append(
        LoadComposableNodes(
            target_container="component_manager_medium",
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="MagnetometerHandlerNode",
                    extra_arguments=extra_arguments,
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="BarometerHandlerNode",
                    extra_arguments=extra_arguments,
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="BatteryHandlerNode",
                    extra_arguments=extra_arguments,
                ),
            ],
        )
    )

    # Launch low priority nodes
    drone_ns.append(
        LoadComposableNodes(
            target_container="component_manager_low",
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="CpuHandlerNode",
                    extra_arguments=extra_arguments,
                ),
                ComposableNode(
                    package="tobas_real_ros",
                    plugin="TimeReferenceServerNode",
                    extra_arguments=extra_arguments,
                ),
            ],
        )
    )

    ld.add_action(GroupAction(actions=drone_ns))
    # ========== namespace {{ drone_name }} ==========

    # Load robot description
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                [PathJoinSubstitution([config_pkg_share, "launch", "robot_state_publisher.launch.py"])]
            ),
            launch_arguments={
                "log_level": log_level,
                "output": output,
                "use_sim_time": "false",
                "user_debug": "false",
            }.items(),
        )
    )

    # Launch Tobas core software
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                [PathJoinSubstitution([config_pkg_share, "launch", "core_component.launch.py"])]
            ),
            launch_arguments={
                "use_sim_time": "false",
                "user_debug": "false",
            }.items(),
        )
    )

    # Launch user nodes
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource([PathJoinSubstitution([user_pkg_share, "launch", "real.launch.py"])])
        )
    )

    return ld
