<launch>

  <arg name="log_level" default="info"/>
  <arg name="output" default="screen"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="user_debug" default="false"/>
  <arg name="world_name" default="basic"/>
  <arg name="verbose" default="3"/>
  <arg name="ground_truth" default="false"/>
  <arg name="launch_core" default="true"/>
  <arg name="x" default="0.0" description="Initial X position in meters."/>
  <arg name="y" default="0.0" description="Initial Y position in meters."/>
  <arg name="z" default="0.3" description="Initial Z position in meters."/>
  <arg name="yaw" default="0.0" description="Initial yaw angle in radians."/>

  <!-- Set common parameters -->
  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- Load robot description -->
  <include file="$(find-pkg-share {{ config_pkg_name }})/launch/robot_state_publisher.launch.py">
    <arg name="log_level" value="$(var log_level)"/>
    <arg name="output" value="$(var output)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="user_debug" value="$(var user_debug)"/>
  </include>

  <!-- Launch a Gazebo world -->
  <include file="$(find-pkg-share tobas_gazebo_sim)/launch/gazebo.launch.xml">
    <arg name="world_name" value="$(var world_name)"/>
    <arg name="verbose" value="$(var verbose)"/>
  </include>

  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>

    <!-- Spawn robot in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" ros_args="--log-level $(var log_level)" args="-topic robot_description -name f450 -x $(var x) -y $(var y) -z $(var z) -Y $(var yaw)" output="$(var output)"/>

    <!-- Launch joint controllers -->
    <include file="$(find-pkg-share tobas_f450_config)/launch/controller_manager.launch.xml"/>

    <!-- Launch Gazebo command handlers -->
    <node pkg="tobas_gazebo_ros" exec="rotor_command_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="tobas_gazebo_ros" exec="joint_command_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>

    <!-- Launch component containers -->
    <node pkg="rclcpp_components" exec="component_container_mt" name="component_manager_high" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="rclcpp_components" exec="component_container_mt" name="component_manager_medium" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="rclcpp_components" exec="component_container_mt" name="component_manager_low" ros_args="--log-level $(var log_level)" output="$(var output)"/>
  </group>

  <!-- Launch Tobas core software -->
  <group if="$(var launch_core)">
    <include file="$(find-pkg-share {{ config_pkg_name }})/launch/core_component.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="ground_truth" value="$(var ground_truth)"/>
    </include>
  </group>

  <!-- Launch user nodes -->
  <include file="$(find-pkg-share {{ user_pkg_name }})/launch/gazebo.launch.py"/>

</launch>
