<launch>

  <arg name="world_name" default="basic"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="user_debug" default="false"/>
  <arg name="log_level" default="3"/>
  <arg name="x" default="0.0" description="Initial X position in meters."/>
  <arg name="y" default="0.0" description="Initial Y position in meters."/>
  <arg name="z" default="0.3" description="Initial Z position in meters."/>
  <arg name="yaw" default="0.0" description="Initial yaw angle in radians."/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- Load robot description -->
  <include file="$(find-pkg-share {{ config_pkg_name }})/launch/robot_state_publisher.launch.py">
    <arg name="user_debug" value="$(var user_debug)"/>
  </include>

  <!-- Launch a Gazebo world -->
  <include file="$(find-pkg-share tobas_gazebo_sim)/launch/gazebo.launch.xml">
    <arg name="world_name" value="$(var world_name)"/>
    <arg name="log_level" value="$(var log_level)"/>
  </include>

  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>

    <!-- Spawn robot in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" output="screen" args="-topic robot_description -name {{ drone_name }} -x $(var x) -y $(var y) -z $(var z) -Y $(var yaw)"/>

    <!-- Launch joint controllers -->
    <include file="$(find-pkg-share {{ config_pkg_name }})/launch/controller_manager.launch.xml"/>

    <!-- Launch Gazebo command handlers -->
    <node pkg="tobas_gazebo_ros" exec="robor_command_handler" name="robor_command_handler" output="screen"/>
    <node pkg="tobas_gazebo_ros" exec="joint_command_handler" name="joint_command_handler" output="screen"/>
  </group>

  <!-- Launch component containers -->
  <include file="$(find-pkg-share {{ config_pkg_name }})/launch/component_manager_high.launch.xml"/>
  <include file="$(find-pkg-share {{ config_pkg_name }})/launch/component_manager_medium.launch.xml"/>
  <include file="$(find-pkg-share {{ config_pkg_name }})/launch/component_manager_low.launch.xml"/>

  <!-- Launch user nodes -->
  <include file="$(find-pkg-share {{ user_pkg_name }})/launch/gazebo.launch.py"/>

</launch>
