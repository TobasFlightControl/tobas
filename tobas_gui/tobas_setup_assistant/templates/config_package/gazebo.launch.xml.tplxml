<launch>

  <arg name="log_level" default="info"/>
  <arg name="output" default="screen"/>
  <arg name="localhost_only" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="user_debug" default="false"/>
  <arg name="world_path" default="$(find-pkg-share tobas_gazebo_sim)/worlds/empty.world"/>
  <arg name="headless" default="false"/>
  <arg name="verbose" default="3"/>
  <arg name="ground_truth" default="false"/>
  <arg name="standalone" default="false"/>
  <arg name="multiprocess" default="true"/>
  <arg name="launch_core" default="true"/>
  <arg name="sbus_device" default=""/>
  <arg name="x" default="0.0" description="Initial X position in meters."/>
  <arg name="y" default="0.0" description="Initial Y position in meters."/>
  <arg name="z" default="0.5" description="Initial Z position in meters."/>
  <arg name="roll" default="0.0" description="Initial roll angle in radians."/>
  <arg name="pitch" default="0.0" description="Initial pitch angle in radians."/>
  <arg name="yaw" default="0.0" description="Initial yaw angle in radians."/>

  <!-- Set environment variables -->
  <group if="$(var localhost_only)">
    <set_env name="ROS_AUTOMATIC_DISCOVERY_RANGE" value="LOCALHOST"/>
  </group>

  <!-- Set common parameters -->
  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- Load robot description -->
  <arg name="xacro_path" default="$(find-pkg-share {{ config_pkg_name }})/urdf/drone.xacro"/>
  <arg name="urdf_text" default="$(command 'xacro $(var xacro_path) DEBUG:=$(var user_debug)')"/>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" namespace="{{ drone_name }}" ros_args="--log-level $(var log_level)" output="$(var output)">
    <param name="robot_description" value="$(var urdf_text)"/>
    <remap from="/tf" to="tf"/>
    <remap from="/tf_static" to="tf_static"/>
  </node>

  <!-- Launch a Gazebo world -->
  <include file="$(find-pkg-share tobas_gazebo_sim)/launch/gazebo.launch.xml">
    <arg name="world_path" value="$(var world_path)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="verbose" value="$(var verbose)"/>
  </include>

  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>

    <!-- Spawn robot in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" ros_args="--log-level $(var log_level)" args="-topic robot_description -name {{ drone_name }} -x $(var x) -y $(var y) -z $(var z) -R $(var roll) -P $(var pitch) -Y $(var yaw)" output="$(var output)"/>

    <!-- Launch Gazebo nodes -->
    <node pkg="tobas_gazebo_ros" exec="cpu_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="tobas_gazebo_ros" exec="rotor_states_publisher" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="tobas_gazebo_ros" exec="electric_rotor_command_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    <node pkg="tobas_gazebo_ros" exec="joint_command_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>
  </group>

  <!-- Launch Tobas core software -->
  <group if="$(var launch_core)">
    <include file="$(find-pkg-share {{ config_pkg_name }})/launch/common.launch.py">
      <arg name="log_level" value="$(var log_level)"/>
      <arg name="output" value="$(var output)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="ground_truth" value="$(var ground_truth)"/>
      <arg name="standalone" value="$(var standalone)"/>
      <arg name="multiprocess" value="$(var multiprocess)"/>
    </include>
  </group>

  <!-- Launch nodes related to RC input -->
  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>
    <group if="$(eval '\'$(var sbus_device)\' != \'\'')">
      <node pkg="tobas_sbus_driver" exec="sbus_driver" ros_args="--log-level $(var log_level)" output="$(var output)">
        <param name="device" value="$(var sbus_device)"/>
      </node>
      <node pkg="tobas_real_ros" exec="rcin_handler" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    </group>
    <group if="$(eval '\'$(var sbus_device)\' == \'\'')">
      <node pkg="tobas_fake_publishers" exec="fake_rcin_publisher" ros_args="--log-level $(var log_level)" output="$(var output)"/>
    </group>
  </group>

  <!-- Launch user nodes -->
  <include file="$(find-pkg-share {{ user_cpp_pkg_name }})/launch/gazebo.launch.py"/>
  <include file="$(find-pkg-share {{ user_py_pkg_name }})/launch/gazebo.launch.py"/>

  <!-- Launch nodes for debug -->
  <node pkg="tobas_matrix_euler_conversion" exec="matrix_euler_converter" namespace="{{ drone_name }}" ros_args="--log-level $(var log_level)" output="$(var output)">
    <remap from="euler" to="gazebo/euler"/>
  </node>
  <node pkg="tobas_matrix_euler_conversion" exec="matrix_euler_converter" name="gazebo_matrix_euler_converter" namespace="{{ drone_name }}" ros_args="--log-level $(var log_level)" output="$(var output)">
    <remap from="odom" to="gazebo/ground_truth/odom"/>
    <remap from="euler" to="gazebo/ground_truth/euler"/>
  </node>

</launch>
