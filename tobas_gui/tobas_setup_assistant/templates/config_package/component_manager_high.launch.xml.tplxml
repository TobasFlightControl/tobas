<launch>

  <arg name="thread_num" default="0" description="number of threads to have in the thread pool, the default 0 will use the number of cpu cores found instead"/>

  <group ns="{{ drone_name }}">
    <node pkg="rclcpp_components" exec="component_container_mt" name="component_manager_high" output="screen">
      <param name="thread_num" value="$(var thread_num)"/>
    </node>
  </group>

</launch>
