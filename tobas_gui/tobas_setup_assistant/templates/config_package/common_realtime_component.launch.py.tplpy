from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, GroupAction
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch.conditions import IfCondition, UnlessCondition
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import LoadComposableNodes, SetParameter, PushRosNamespace
from launch_ros.descriptions import ComposableNode
from launch_ros.substitutions import FindPackageShare

# Template parameters
DRONE_NAME = "{{ drone_name }}"
CONFIG_PKG_NAME = "{{ config_pkg_name }}"
USER_CPP_PKG_NAME = "{{ user_cpp_pkg_name }}"
CONTROLLER_PKG = "{{ controller_pkg }}"
CONTROLLER_PLUGIN = "{{ controller_plugin }}"
MISSION_EXECUTOR_PKG = "{{ mission_executor_pkg }}"
MISSION_EXECUTOR_PLUGIN = "{{ mission_executor_plugin }}"

# Arguments
LOG_LEVEL = "log_level"
OUTPUT = "output"
USE_SIM_TIME = "use_sim_time"
MULTIPROCESS = "multiprocess"
ID = "id"


def generate_launch_description():
    ld = LaunchDescription()

    # Declare arguments
    ld.add_action(DeclareLaunchArgument(LOG_LEVEL, default_value="info"))
    ld.add_action(DeclareLaunchArgument(OUTPUT, default_value="screen"))
    ld.add_action(DeclareLaunchArgument(USE_SIM_TIME, default_value="false"))
    ld.add_action(DeclareLaunchArgument(MULTIPROCESS, default_value="false"))
    ld.add_action(DeclareLaunchArgument(ID, default_value="id0"))

    # Get arguments
    log_level = LaunchConfiguration(LOG_LEVEL)
    output = LaunchConfiguration(OUTPUT)
    use_sim_time = LaunchConfiguration(USE_SIM_TIME)
    multiprocess = LaunchConfiguration(MULTIPROCESS)
    id = LaunchConfiguration(ID)

    # Set common parameters
    # cf. https://zenn.dev/ntrlmt/articles/d41c7e220ff0fe
    ld.add_action(SetParameter(USE_SIM_TIME, value=use_sim_time))

    namespace = PathJoinSubstitution([DRONE_NAME, id])
    config_pkg_share = FindPackageShare(CONFIG_PKG_NAME)
    user_cpp_pkg_share = FindPackageShare(USER_CPP_PKG_NAME)

    # Launch component containers
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                PathJoinSubstitution([config_pkg_share, "launch", "component_containers_mp.launch.py"])
            ),
            launch_arguments={"log_level": log_level, "output": output, "id": id}.items(),
            condition=IfCondition(multiprocess),
        )
    )
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource(
                PathJoinSubstitution([config_pkg_share, "launch", "component_containers_sp.launch.py"])
            ),
            launch_arguments={"log_level": log_level, "output": output, "id": id}.items(),
            condition=UnlessCondition(multiprocess),
        )
    )

    # Launch 1st priority nodes (Twist Control)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_1"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_eskf",
                    plugin="tobas::ErrorStateKalmanFilterNode",
                    name="observer",
                    namespace=namespace,
                    parameters=[
                        PathJoinSubstitution([config_pkg_share, "config", "observer_static.yaml"]),
                        PathJoinSubstitution([config_pkg_share, "config", "observer_dynamic.yaml"]),
                    ],
                    remappings=[("/tf", "tf"), ("/tf_static", "tf_static")],
                ),
                ComposableNode(
                    package=CONTROLLER_PKG,
                    plugin=CONTROLLER_PLUGIN,
                    name="controller",
                    namespace=namespace,
                    parameters=[
                        PathJoinSubstitution([config_pkg_share, "config", "controller_static.yaml"]),
                        PathJoinSubstitution([config_pkg_share, "config", "controller_dynamic.yaml"]),
                    ],
                ),
                ComposableNode(
                    package="tobas_rotor_controller",
                    plugin="tobas::RotorControllerNode",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch 2nd priority nodes (Pose Control & Navigation & Manipulation)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_2"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_disturbance_observer",
                    plugin="tobas::DisturbanceObserverNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_rc_teleop",
                    plugin="tobas::rc::RCTeleopNode",
                    namespace=namespace,
                    parameters=[
                        PathJoinSubstitution([config_pkg_share, "config", "rc_teleop_static.yaml"]),
                        PathJoinSubstitution([config_pkg_share, "config", "rc_teleop_dynamic.yaml"]),
                    ],
                ),
                ComposableNode(
                    package=MISSION_EXECUTOR_PKG,
                    plugin=MISSION_EXECUTOR_PLUGIN,
                    namespace=namespace,
                    parameters=[PathJoinSubstitution([config_pkg_share, "config", "mission_executor_static.yaml"])],
                ),
                ComposableNode(
                    package="tobas_object_avoidance",
                    plugin="tobas::ObjectAvoidance",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch 3th priority nodes (Others)
    ld.add_action(
        LoadComposableNodes(
            target_container=PathJoinSubstitution([namespace, "component_manager_3"]),
            composable_node_descriptions=[
                ComposableNode(
                    package="tobas_connection_monitor",
                    plugin="tobas::HeartbeatSenderNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_tree_server",
                    plugin="tobas::TreeServerNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_drone_server",
                    plugin="tobas::DroneServerNode",
                    namespace=namespace,
                    parameters=[
                        {
                            "tbsdrn_path": PathJoinSubstitution([config_pkg_share, "config", "drone.tbsdrn"]),
                        }
                    ],
                ),
                ComposableNode(
                    package="tobas_rosbag_recorder",
                    plugin="tobas::RosbagRecorderNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_config_servers",
                    plugin="tobas::ImuFilterConfigServer",
                    namespace=namespace,
                    parameters=[
                        PathJoinSubstitution([config_pkg_share, "config", "imu_filter_static.yaml"]),
                        PathJoinSubstitution([config_pkg_share, "config", "imu_filter_dynamic.yaml"]),
                    ],
                ),
                ComposableNode(
                    package="tobas_config_servers",
                    plugin="tobas::RpmControlConfigServer",
                    namespace=namespace,
                    parameters=[PathJoinSubstitution([config_pkg_share, "config", "rpm_control_dynamic.yaml"])],
                ),
                ComposableNode(
                    package="tobas_failsafe",
                    plugin="tobas::HealthMonitorNode",
                    namespace=namespace,
                    parameters=[PathJoinSubstitution([config_pkg_share, "config", "health_monitor.yaml"])],
                ),
                ComposableNode(
                    package="tobas_failsafe",
                    plugin="tobas::FailsafeExecutorNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_landing_detection",
                    plugin="tobas::LandingDetectorNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_rotor_anomaly_detection",
                    plugin="tobas::RotorAnomalyDetectorNode",
                    namespace=namespace,
                    parameters=[PathJoinSubstitution([config_pkg_share, "config", "rotor_anomaly_detector.yaml"])],
                ),
                ComposableNode(
                    package="tobas_vibration_filter",
                    plugin="tobas::VibrationFilterNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_joint_states_bridge",
                    plugin="tobas::JointStatesBridgeNode",
                    namespace=namespace,
                ),
                ComposableNode(
                    package="tobas_topic_throttle",
                    plugin="tobas::TopicThrottleNode",
                    namespace=namespace,
                ),
            ],
        )
    )

    # Launch user nodes
    ld.add_action(
        GroupAction(
            [
                PushRosNamespace(namespace),
                IncludeLaunchDescription(
                    PythonLaunchDescriptionSource(
                        PathJoinSubstitution([user_cpp_pkg_share, "launch", "common_realtime.launch.py"])
                    )
                ),
            ]
        )
    )

    return ld
