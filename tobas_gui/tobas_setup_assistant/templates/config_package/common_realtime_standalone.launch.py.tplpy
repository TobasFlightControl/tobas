from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, GroupAction
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch_ros.actions import Node, SetParameter, PushRosNamespace
from launch_ros.substitutions import FindPackageShare

# Template parameters
DRONE_NAME = "{{ drone_name }}"
CONFIG_PKG_NAME = "{{ config_pkg_name }}"
USER_CPP_PKG_NAME = "{{ user_cpp_pkg_name }}"
CONTROLLER_PKG = "{{ controller_pkg }}"
MISSION_EXECUTOR_PKG = "{{ mission_executor_pkg }}"

# Arguments
LOG_LEVEL = "log_level"
OUTPUT = "output"
USE_SIM_TIME = "use_sim_time"
ID = "id"


def generate_launch_description():
    ld = LaunchDescription()

    # Declare arguments
    ld.add_action(DeclareLaunchArgument(LOG_LEVEL, default_value="info"))
    ld.add_action(DeclareLaunchArgument(OUTPUT, default_value="screen"))
    ld.add_action(DeclareLaunchArgument(USE_SIM_TIME, default_value="false"))
    ld.add_action(DeclareLaunchArgument(ID, default_value="id0"))

    # Get arguments
    log_level = LaunchConfiguration(LOG_LEVEL)
    output = LaunchConfiguration(OUTPUT)
    use_sim_time = LaunchConfiguration(USE_SIM_TIME)
    id = LaunchConfiguration(ID)

    # Set common parameters
    # cf. https://zenn.dev/ntrlmt/articles/d41c7e220ff0fe
    ld.add_action(SetParameter(USE_SIM_TIME, value=use_sim_time))

    namespace = PathJoinSubstitution([DRONE_NAME, id])
    config_pkg_share = FindPackageShare(CONFIG_PKG_NAME)
    user_cpp_pkg_share = FindPackageShare(USER_CPP_PKG_NAME)

    tf_remap = [("/tf", "tf"), ("/tf_static", "tf_static")]
    ros_args = ["--log-level", log_level, "--disable-rosout-logs", "--disable-external-lib-logs"]

    # Launch 1st priority nodes (Twist Control)
    ld.add_action(
        Node(
            package="tobas_eskf",
            executable="eskf_node",
            name="observer",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "observer_static_standalone.yaml"])],
            remappings=tf_remap,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package=CONTROLLER_PKG,
            executable="controller",
            name="controller",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "controller_static_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_rotor_controller",
            executable="rotor_controller",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_disturbance_observer",
            executable="disturbance_observer",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )

    # Launch 2nd priority nodes (Pose Control & Navigation & Manipulation)
    ld.add_action(
        Node(
            package="tobas_rc_teleop",
            executable="rc_teleop",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "rc_teleop_static_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package=MISSION_EXECUTOR_PKG,
            executable="mission_executor",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "mission_executor_static_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_object_avoidance",
            executable="object_avoidance",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )

    # Launch 3th priority nodes (Others)
    ld.add_action(
        Node(
            package="tobas_connection_monitor",
            executable="heartbeat_sender",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_tree_server",
            executable="tree_server",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_drone_server",
            executable="drone_server",
            namespace=namespace,
            parameters=[{"tbsdrn_path": PathJoinSubstitution([config_pkg_share, "config", "drone.tbsdrn"])}],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_rosbag_recorder",
            executable="rosbag_recorder",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_config_servers",
            executable="imu_filter_config_server",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "imu_filter_static_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_config_servers",
            executable="rpm_control_config_server",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_failsafe",
            executable="health_monitor",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "health_monitor_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_failsafe",
            executable="failsafe_executor",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_landing_detection",
            executable="landing_detector",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_rotor_anomaly_detection",
            executable="rotor_anomaly_detector",
            namespace=namespace,
            parameters=[PathJoinSubstitution([config_pkg_share, "config", "rotor_anomaly_detector_standalone.yaml"])],
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_vibration_filter",
            executable="vibration_filter",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_joint_states_bridge",
            executable="joint_states_bridge",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )
    ld.add_action(
        Node(
            package="tobas_topic_throttle",
            executable="topic_throttle",
            namespace=namespace,
            ros_arguments=ros_args,
            output=output,
        )
    )

    # Launch user nodes
    ld.add_action(
        GroupAction(
            [
                PushRosNamespace(namespace),
                IncludeLaunchDescription(
                    PythonLaunchDescriptionSource(
                        PathJoinSubstitution([user_cpp_pkg_share, "launch", "common_realtime.launch.py"])
                    )
                ),
            ]
        )
    )

    return ld
