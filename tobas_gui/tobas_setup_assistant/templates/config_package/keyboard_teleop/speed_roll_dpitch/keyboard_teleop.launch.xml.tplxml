<launch>

  <arg name="log_level" default="info"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="ground_truth" default="false"/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>

    <node pkg="tobas_keyboard_teleop" exec="speed_roll_dpitch_publisher_node" output="screen" ros_args="--log-level $(var log_level)">
      <remap if="$(var ground_truth)" from="odom" to="ground_truth/odom"/>
    </node>
  </group>

</launch>
