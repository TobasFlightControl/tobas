<launch>

  <arg name="log_level" default="info"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="ground_truth" default="false"/>

  <!-- Set common parameters -->
  <set_parameter name="log_level" value="$(var log_level)"/>
  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- Launch Tobas core software -->
  <!-- TODO: Improve communication latency and launch bringup.launch on the flight controller side. -->
  <include file="$(find {{ config_pkg_name }})/launch/bringup.launch.py">
    <arg name="log_level" value="$(var log_level)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="ground_truth" value="$(var ground_truth)"/>
  </include>

  <group>
    <push_ros_namespace namespace="{{ drone_name }}"/>

    <!-- Launch minimal hardware interfaces -->
    <include file="$(find-pkg-share {{ hardware_pkg }})/launch/rcin_driver.launch.py"/>
    <node pkg="tobas_real_ros" exec="rcin_handler" output="screen"/>
  </group>

</launch>
