from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch.launch_description_sources import PythonLaunchDescriptionSource

from launch_ros.actions import Node, SetParameter
from launch_ros.substitutions import FindPackageShare

# Template parameters
DRONE_NAME = "{{ drone_name }}"
CONFIG_PKG_NAME = "{{ config_pkg_name }}"
USER_PKG_NAME = "{{ user_pkg_name }}"
OBSERVER_PKG = "{{ observer_pkg }}"
CONTROLLER_PKG = "{{ controller_pkg }}"
ACTIONS_PKG = "{{ actions_pkg }}"

# Arguments
USE_SIM_TIME = "use_sim_time"
GROUND_TRUTH = "ground_truth"


def generate_launch_description():
    ld = LaunchDescription()

    # Declare arguments
    ld.add_action(DeclareLaunchArgument(USE_SIM_TIME, default_value="true"))
    ld.add_action(DeclareLaunchArgument(GROUND_TRUTH, default_value="false"))

    # Get arguments
    use_sim_time = LaunchConfiguration(USE_SIM_TIME)
    ground_truth = LaunchConfiguration(GROUND_TRUTH)

    # Set common parameters
    # cf. https://zenn.dev/ntrlmt/articles/d41c7e220ff0fe
    ld.add_action(SetParameter(USE_SIM_TIME, value=use_sim_time))

    config_pkg_share = FindPackageShare(CONFIG_PKG_NAME)
    user_pkg_share = FindPackageShare(USER_PKG_NAME)
    odom_remap = [("odom", "ground_truth/odom")] if ground_truth == "true" else []  # TODO: Apply remappings

    # Launch high priority nodes
    ld.add_action(Node(package=OBSERVER_PKG, executable="observer", name="observer"))  # TODO: rosparam
    ld.add_action(Node(package=OBSERVER_PKG, executable="controller", name="controller"))  # TODO: rosparam
    ld.add_action(Node(package="tobas_rc_teleop", executable="rc_teleop"))  # TODO: rosparam
    ld.add_action(Node(package="tobas_preprocess", executable="imu_lpf"))
    ld.add_action(Node(package="tobas_rotor_controller", executable="rotor_controller"))

    # Launch medium priority nodes
    ld.add_action(Node(package="tobas_preprocess", executable="battery_lpf"))
    ld.add_action(Node(package="tobas_preprocess", executable="matrix_euler_converter"))
    ld.add_action(Node(package="tobas_latency_publisher", executable="latency_publisher"))
    ld.add_action(Node(package="tobas_manipulation", executable="position_controller"))
    ld.add_action(Node(package="tobas_manipulation", executable="velocity_controller"))
    ld.add_action(Node(package="tobas_manipulation", executable="effort_controller"))

    # Launch low priority nodes
    ld.add_action(Node(package=ACTIONS_PKG, executable="takeoff_server"))
    ld.add_action(Node(package=ACTIONS_PKG, executable="land_server"))
    ld.add_action(Node(package=ACTIONS_PKG, executable="move_server"))
    ld.add_action(Node(package="tobas_tree_server", executable="tree_server"))
    ld.add_action(
        Node(
            package="tobas_drone_server",
            executable="drone_server",
            parameters=[
                {
                    "tbsdrn_path": PathJoinSubstitution([config_pkg_share, "config", "drone.tbsdrn"]),
                }
            ],
        )
    )
    ld.add_action(Node(package="tobas_prearm_check", executable="prearm_checker"))
    ld.add_action(Node(package="tobas_state_checker", executable="state_checker"))
    ld.add_action(Node(package="tobas_topic_throttle", executable="battery_throttle"))
    ld.add_action(Node(package="tobas_topic_throttle", executable="euler_throttle"))
    ld.add_action(Node(package="tobas_topic_throttle", executable="latency_throttle"))
    ld.add_action(Node(package="tobas_topic_throttle", executable="rc_input_throttle"))

    # Launch user nodes
    ld.add_action(
        IncludeLaunchDescription(
            PythonLaunchDescriptionSource([PathJoinSubstitution([user_pkg_share, "launch", "common.launch.py"])])
        )
    )

    return ld
