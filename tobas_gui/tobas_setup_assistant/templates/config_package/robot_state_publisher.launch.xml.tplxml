<launch>

  <arg name="use_sim_time" default="false"/>
  <arg name="user_debug" default="false"/>

  <let name="robot_description_content" value="$(command '$(find-pkg-share-exec xacro) $(find-pkg-share {{ config_pkg_name }})/urdf/drone.xacro DEBUG:=$(var user_debug)')"/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <group ns="{{ drone_name }}">
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
      <param name="robot_description" value="$(var robot_description_content)"/>
    </node>
  </group>

</launch>
