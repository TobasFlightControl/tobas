<launch>

  <arg name="nodelet" default="true"/>

  <arg name="cpu_name" value="cpu_handler"/>
  <arg name="bat_name" value="battery_handler"/>
  <arg name="imu_name" value="imu_handler"/>
  <arg name="bar_name" value="barometer_handler"/>
  <arg name="gps_name" value="gps_handler"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg cpu_name)" args="load tobas_real/CpuHandlerNodelet nodelet_manager" output="screen"/>
    <node pkg="nodelet" type="nodelet" name="$(arg bat_name)" args="load tobas_real/BatteryHandlerNodelet nodelet_manager" output="screen"/>
    <node pkg="nodelet" type="nodelet" name="$(arg imu_name)" args="load tobas_real/ImuHandlerNodelet nodelet_manager" output="screen"/>
    <node pkg="nodelet" type="nodelet" name="$(arg bar_name)" args="load tobas_real/BarometerHandlerNodelet nodelet_manager" output="screen"/>
    <node pkg="nodelet" type="nodelet" name="$(arg gps_name)" args="load tobas_real/GpsHandlerNodelet nodelet_manager" output="screen"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_real" type="cpu_handler_node" name="$(arg cpu_name)" output="screen"/>
    <node pkg="tobas_real" type="battery_handler_node" name="$(arg bat_name)" output="screen"/>
    <node pkg="tobas_real" type="imu_handler_node" name="$(arg imu_name)" output="screen"/>
    <node pkg="tobas_real" type="barometer_handler_node" name="$(arg bar_name)" output="screen"/>
    <node pkg="tobas_real" type="gps_handler_node" name="$(arg gps_name)" output="screen"/>
  </group>

</launch>
