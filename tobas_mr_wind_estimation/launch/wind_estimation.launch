<launch>

  <arg name="nodelet" default="false"/>

  <arg name="node_name" value="wind_estimator"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_mr_wind_estimation/WindEstimatorNodelet nodelet_manager" output="screen"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_mr_wind_estimation" type="wind_estimator_node" name="$(arg node_name)" output="screen"/>
  </group>

</launch>
