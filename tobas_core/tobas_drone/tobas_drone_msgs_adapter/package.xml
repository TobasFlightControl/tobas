<package format="3">

	<name>tobas_drone_msgs_adapter</name>
	<version>2.16.0</version>
	<description>ROS 2 type adapters for Tobas vehicle, airframe, actuator, and propulsion configuration messages.</description>
	<maintainer email="m.dohi@tobas.jp">Masayoshi Dohi</maintainer>
	<license>GPL-3.0-or-later</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<build_depend>rosidl_default_generators</build_depend>
	<exec_depend>rosidl_default_runtime</exec_depend>
	<member_of_group>rosidl_interface_packages</member_of_group>

	<depend>tobas_drone_core</depend>
	<depend>tobas_drone_msgs</depend>
	<depend>tobas_std_msgs_adapter</depend>
	<depend>tobas_kdl_msgs_adapter</depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>

</package>
