   "source": [
    "import numpy as np\n",
    "from tobas_std_tools_py.optimization import newton_1d"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "a = 100\n",
    "f = lambda x: x * np.exp(x) - a\n",
    "df = lambda x: (x + 1.) * np.exp(x)\n",
    "\n",
    "x0 = 0\n",
    "x_opt = newton_1d(f=f, df=df, x0=x0)\n",
    "print(f'x_opt = {x_opt}, f(x_opt) = {f(x_opt)}')"
   ]
  },
