<package format="3">

	<name>tobas_kdl_msgs</name>
	<version>2.16.0</version>
	<description>ROS 2 message definitions for KDL geometry, motion, inertia, joints, segments, and trees.</description>
	<maintainer email="m.dohi@tobas.jp">Masayoshi Dohi</maintainer>
	<license>Apache-2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<build_depend>rosidl_default_generators</build_depend>
	<exec_depend>rosidl_default_runtime</exec_depend>
	<member_of_group>rosidl_interface_packages</member_of_group>

	<depend>std_msgs</depend>
	<depend>tobas_eigen_msgs</depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>

</package>
