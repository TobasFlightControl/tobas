<package format="3">

	<name>tobas_rosbag_recorder</name>
	<version>2.16.0</version>
	<description>Configurable recorder for Tobas command, sensor, model, debug, and state topics.</description>
	<maintainer email="m.dohi@tobas.jp">Masayoshi Dohi</maintainer>
	<license>GPL-3.0-or-later</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<depend>rosbag2_cpp</depend>
	<depend>std_srvs</depend>
	<depend>tobas_path_tools</depend>
	<depend>tobas_linux</depend>
	<depend>tobas_node</depend>
	<depend>tobas_msgs_adapter</depend>
	<depend>tobas_command_msgs_adapter</depend>
	<depend>tobas_drone_msgs_adapter</depend>
	<depend>tobas_debug_msgs_adapter</depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>

</package>
