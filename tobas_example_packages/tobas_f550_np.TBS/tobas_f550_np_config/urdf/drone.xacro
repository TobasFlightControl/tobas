    </material>
    <link name="base_link"/>
    <link name="battery">
        <inertial>
            <mass value="0.496"/>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <inertia ixx="0.000137557" ixy="0" ixz="0" iyy="0.00103536" iyz="0" izz="0.00108827"/>
        </inertial>
        <visual>
