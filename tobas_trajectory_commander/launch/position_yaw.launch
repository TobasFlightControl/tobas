<launch>

  <arg name="nodelet" default="false"/>

  <arg name="node_name" value="follow_position_yaw_trajectory_server"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_trajectory_commander/FollowPositionYawTrajectoryServerNodelet nodelet_manager" output="screen" required="true"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_trajectory_commander" type="position_yaw_node" name="$(arg node_name)" output="screen" required="true"/>
  </group>

</launch>
