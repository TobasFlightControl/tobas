<launch>



  <arg name="node_name" value="rotor_controller"/>

  <node if="$(arg nodelet)" pkg="nodelet" exec="nodelet" name="$(arg node_name)" args="load tobas_rotor_controller/RotorControllerNodelet nodelet_manager_high" output="screen"/>
  <node unless="$(arg nodelet)" pkg="tobas_rotor_controller" exec="rotor_controller_node" name="$(arg node_name)" output="screen"/>

</launch>
