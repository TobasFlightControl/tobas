Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: URDF Builder Panel
    Name: URDF Builder Panel

Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Alpha: 0.5
      Cell Size: 0.1
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Axes
      Alpha: 1
      Enabled: true
      Length: 0.1
      Name: Axes
      Radius: 0.01
      Reference Frame: <Fixed Frame>
      Show Trail: false
      Value: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8.436497688293457
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.8
      Focal Point:
        X: 0.1586606353521347
        Y: 0.1473492681980133
        Z: 0.12370522320270538
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.35499992966651917
      Target Frame: <Fixed Frame>
      Yaw: 5.343594551086426

Window Geometry:
  Displays:
    collapsed: false
  Height: 1043
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  URDF Builder Panel:
    collapsed: false
  Views:
    collapsed: true
  Width: 1920
  X: 0
  Y: 0
