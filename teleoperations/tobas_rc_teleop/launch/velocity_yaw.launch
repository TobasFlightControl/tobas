<launch>

  <arg name="nodelet" default="true"/>
  <arg name="delay" default="0"/>

  <arg name="node_name" value="rc_teleop"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_rc_teleop/RcinToVelocityYawNodelet nodelet_manager" output="screen" launch-prefix="bash -c 'sleep $(arg delay); $0 $@'"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_rc_teleop" type="velocity_yaw_node" name="$(arg node_name)" output="screen"/>
  </group>

</launch>
