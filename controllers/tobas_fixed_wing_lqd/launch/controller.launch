<launch>

  <arg name="nodelet" default="true"/>
  <arg name="ground_truth" default="false"/>

  <arg name="node_name" value="tobas_fixed_wing_lqd"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_fixed_wing_lqd/ControllerNodelet nodelet_manager" output="screen">
      <remap if="$(arg ground_truth)" from="base_state" to="ground_truth/base_state"/>
    </node>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_fixed_wing_lqd" type="controller_node" name="$(arg node_name)" output="screen">
      <remap if="$(arg ground_truth)" from="base_state" to="ground_truth/base_state"/>
    </node>
  </group>

</launch>
