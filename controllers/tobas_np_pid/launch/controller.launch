<launch>

  <arg name="nodelet" default="false"/>
  <arg name="ground_truth" default="false"/>

  <arg name="node_name" value="tobas_np_pid"/>

  <node if="$(arg nodelet)" pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_np_pid/ControllerNodelet nodelet_manager" output="screen">
    <remap if="$(arg ground_truth)" from="pose_twist" to="ground_truth/pose_twist"/>
  </node>
  <node unless="$(arg nodelet)" pkg="tobas_np_pid" type="controller_node" name="$(arg node_name)" output="screen">
    <remap if="$(arg ground_truth)" from="pose_twist" to="ground_truth/pose_twist"/>
  </node>

</launch>
