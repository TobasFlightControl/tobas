# User environment
HOME=/home/pi

# ROS 2 communication
ROS_DOMAIN_ID=20
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ROS 2 logging
# Store launch logs in RAM instead of persistent storage.
ROS_LOG_DIR=/run/ros/log

# Disable external logging (e.g., spdlog file output).
# Console logging and /rosout are controlled separately.
RCL_LOGGING_IMPLEMENTATION=rcl_logging_noop

# Disable ROS 2 tracing to reduce runtime overhead.
TRACETOOLS_RUNTIME_DISABLE=1

# Tobas clock configuration
# Use a monotonic clock independent of system time changes.
TOBAS_CLOCK_TYPE=steady_time
