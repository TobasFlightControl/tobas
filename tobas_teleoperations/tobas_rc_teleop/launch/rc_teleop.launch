<launch>

  <arg name="nodelet" default="false"/>

  <arg name="node_name" value="rc_teleop"/>

  <node if="$(arg nodelet)" pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_rc_teleop/RCTeleopNodelet nodelet_manager_high" output="screen" required="true"/>
  <node unless="$(arg nodelet)" pkg="tobas_rc_teleop" type="rc_teleop_node" name="$(arg node_name)" output="screen" required="true"/>

</launch>
