# Clang-Format Style Options: https://releases.llvm.org/21.1.2/tools/clang/docs/ClangFormatStyleOptions.html

BasedOnStyle: Google
ColumnLimit: 120
CommentPragmas: "^ (IWYU pragma:|Source:)"
MaxEmptyLinesToKeep: 1
SortIncludes:
  Enabled: true
  IgnoreCase: false
IncludeBlocks: Preserve

Standard: c++20
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -2
ConstructorInitializerIndentWidth: 2
NamespaceIndentation: None
ContinuationIndentWidth: 2
IndentCaseLabels: true
IndentFunctionDeclarationAfterType: false

AlignEscapedNewlines: Right
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

AllowAllParametersOfDeclarationOnNextLine: false
ExperimentalAutoDetectBinPacking: false
ObjCSpaceBeforeProtocolList: true
Cpp11BracedListStyle: false

AllowShortBlocksOnASingleLine: Always
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false

BreakTemplateDeclarations: Yes
AlwaysBreakBeforeMultilineStrings: false
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false
BreakConstructorInitializers: BeforeComma

BinPackArguments: false
BinPackParameters: OnePerLine
PackConstructorInitializers: NextLine
DerivePointerAlignment: false
PointerAlignment: Left

PenaltyExcessCharacter: 50
PenaltyBreakBeforeFirstCallParameter: 30
PenaltyBreakComment: 1000
PenaltyBreakFirstLessLess: 10
PenaltyBreakString: 100
PenaltyReturnTypeOnItsOwnLine: 50

SpacesBeforeTrailingComments: 2
SpacesInParens: Never
SpacesInAngles: Never
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpaceBeforeAssignmentOperators: true

# Configure each individual brace in BraceWrapping
BreakBeforeBraces: Custom

# Qualifiers (const, volatile, static, etc)
QualifierAlignment: Custom
QualifierOrder: ["static", "inline", "constexpr", "const", "volatile", "type"]

# Control of individual brace wrapping cases
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# Others
AlignAfterOpenBracket: AlwaysBreak
AlignOperands: Align
FixNamespaceComments: true
ShortNamespaceLines: 0
InsertBraces: true
AllowAllArgumentsOnNextLine: true
RemoveEmptyLinesInUnwrappedLines: true
EnumTrailingComma: Insert
