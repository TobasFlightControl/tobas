# Base: [moveit2/.clang-format](https://github.com/moveit/moveit2/blob/main/.clang-format)
# cf. [Clang-Formatの書式について](https://qiita.com/koyukitukimino/items/9b8f74d1ae307a7017d3)

BasedOnStyle: Google
ColumnLimit: 120
MaxEmptyLinesToKeep: 1
SortIncludes: false

Standard: c++20 # Auto -> c++20
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -2
ConstructorInitializerIndentWidth: 2
NamespaceIndentation: None
ContinuationIndentWidth: 2 # 4 -> 2
IndentCaseLabels: true
IndentFunctionDeclarationAfterType: false

AlignEscapedNewlinesLeft: false
AlignTrailingComments: true

AllowAllParametersOfDeclarationOnNextLine: false
ExperimentalAutoDetectBinPacking: false
ObjCSpaceBeforeProtocolList: true
Cpp11BracedListStyle: false

AllowShortBlocksOnASingleLine: true
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false

AlwaysBreakTemplateDeclarations: true
AlwaysBreakBeforeMultilineStrings: false
BreakBeforeBinaryOperators: false
BreakBeforeTernaryOperators: false
BreakConstructorInitializersBeforeComma: true

BinPackArguments: false # Added
BinPackParameters: false # true -> false
ConstructorInitializerAllOnOneLineOrOnePerLine: true
DerivePointerBinding: false
PointerBindsToType: true

PenaltyExcessCharacter: 50
PenaltyBreakBeforeFirstCallParameter: 30
PenaltyBreakComment: 1000
PenaltyBreakFirstLessLess: 10
PenaltyBreakString: 100
PenaltyReturnTypeOnItsOwnLine: 50

SpacesBeforeTrailingComments: 2
SpacesInParentheses: false
SpacesInAngles: false
SpaceInEmptyParentheses: false
SpacesInCStyleCastParentheses: false
SpaceAfterCStyleCast: false
SpaceAfterControlStatementKeyword: true
SpaceBeforeAssignmentOperators: true

# Configure each individual brace in BraceWrapping
BreakBeforeBraces: Custom

# Qualifiers (const, volatile, static, etc)
QualifierAlignment: Custom
QualifierOrder: ["static", "inline", "constexpr", "const", "volatile", "type"]

# Control of individual brace wrapping cases
BraceWrapping:
  AfterCaseLabel: false # true -> false
  AfterClass: true
  AfterControlStatement: false # true -> false
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true # Added
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: "true" # Added
  BeforeWhile: false # Added
  IndentBraces: false
  SplitEmptyFunction: true # Added
  SplitEmptyRecord: true # Added
  SplitEmptyNamespace: true # Added

# ===== Added =====
AlignAfterOpenBracket: AlwaysBreak # 引数が1行に収まらなければ全ての引数を1段下げる
AlignOperands: true # 長い式の演算子を縦に揃える
FixNamespaceComments: true # 名前空間の閉じ括弧にコメントを追加/修正
ShortNamespaceLines: 0 # 名前空間内に1行以上記述されていれば閉じ括弧にコメントを追加
InsertBraces: true # 必ず{}を挿入する
AllowAllArgumentsOnNextLine: true # 引数が1行に収まらない場合に改行して次の1行にまとめることを許可する
# RemoveEmptyLinesInUnwrappedLines: true # clang-format 20+
