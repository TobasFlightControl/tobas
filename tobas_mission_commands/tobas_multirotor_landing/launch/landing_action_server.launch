<launch>


  <arg name="ground_truth" default="false"/>

  <arg name="node_name" value="landing_action_server"/>

  <node if="$(arg nodelet)" pkg="nodelet" exec="nodelet" name="$(arg node_name)" args="load tobas_multirotor_landing/LandActionServerNodelet nodelet_manager_medium" output="screen">
    <remap if="$(arg ground_truth)" from="odom" to="ground_truth/odom"/>
  </node>
  <node unless="$(arg nodelet)" pkg="tobas_multirotor_landing" exec="landing_action_server_node" name="$(arg node_name)" output="screen">
    <remap if="$(arg ground_truth)" from="odom" to="ground_truth/odom"/>
  </node>

</launch>
