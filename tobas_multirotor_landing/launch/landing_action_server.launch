<launch>

  <arg name="nodelet" default="true"/>
  <arg name="delay" default="0"/>

  <arg name="node_name" value="landing_action_server"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load tobas_multirotor_landing/MultirotorLandServerNodelet nodelet_manager" output="screen" launch-prefix="bash -c 'sleep $(arg delay); $0 $@'"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="tobas_multirotor_landing" type="landing_action_server_node" name="$(arg node_name)" output="screen"/>
  </group>

</launch>
