#!/usr/bin/env python3

import shutil
import subprocess
import sys

SERVICE_TYPE = "_tobas-fc._tcp"


def main() -> int:
    if not shutil.which("avahi-browse"):
        print("avahi-browse is not installed. Install the avahi-utils package.", file=sys.stderr)
        return 1

    try:
        result = subprocess.run(
            ["avahi-browse", "--parsable", "--resolve", "--terminate", SERVICE_TYPE],
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        print("Failed to scan for Tobas flight controllers.", file=sys.stderr)
        return 1

    addresses: set[str] = set()

    for line in result.stdout.splitlines():
        fields = line.split(";", 9)
        if len(fields) < 10:
            continue

        event_type = fields[0]
        if event_type != "=":
            continue

        protocol = fields[2]
        if protocol != "IPv4":
            continue

        service_type = fields[4]
        if service_type != SERVICE_TYPE:
            continue

        hostname = fields[6]
        if not hostname:
            continue

        address = fields[7]
        if not address or address in addresses:
            continue

        if not addresses:
            print("HOSTNAME\tIP ADDRESS\tTXT")

        txt = fields[9]
        print(f"{hostname}\t{address}\t{txt}")

        addresses.add(address)

    if not addresses:
        print("No Tobas flight controllers found.", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
