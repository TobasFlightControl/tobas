#!/bin/bash

# Git Add/Stage/Push

set -e

# Check usage
if [ $# -eq 0 ]; then
  echo "Usage: $(basename "$0") <commit message>"
  exit 1
fi

# Move to the repository root
PARDIR=$(realpath $(dirname "$0"))
cd ${PARDIR}/../../

# Check that this is a git repository
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: not a git repository (run inside a repo)."
  exit 1
fi

# Stage all changes
git add -A

# Commit if there are changes
if ! git diff --cached --quiet; then
  msg="$*" # Combine all arguments into one message
  git commit -m "$msg"
else
  echo "Nothing to commit (working tree clean after add)."
fi

# Push: use the upstream branch if configured, otherwise set -u on the first remote.
if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  git push
else
  remote="$(git remote | head -n1 || true)"
  if [ -z "$remote" ]; then
    echo "No remote configured. Set a remote (e.g., 'origin') then run again."
    exit 2
  fi
  git push -u "$remote" HEAD
fi
