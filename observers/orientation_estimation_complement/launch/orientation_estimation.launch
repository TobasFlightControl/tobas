<launch>

  <arg name="nodelet" default="true"/>
  <arg name="delay" default="0"/>

  <arg name="node_name" value="orientation_estimator_complement"/>

  <group if="$(arg nodelet)">
    <node pkg="nodelet" type="nodelet" name="$(arg node_name)" args="load orientation_estimation_complement/OrientationEstimatorNodelet nodelet_manager" output="screen" launch-prefix="bash -c 'sleep $(arg delay); $0 $@'"/>
  </group>

  <group unless="$(arg nodelet)">
    <node pkg="orientation_estimation_complement" type="orientation_estimator_node" name="$(arg node_name)" output="screen"/>
  </group>

</launch>
