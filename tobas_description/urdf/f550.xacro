<?xml version="1.0"?>

<robot name="f550"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Included URDF Files -->
  <xacro:include filename="$(find tobas_description)/urdf/components/multirotor_base.xacro"/>
  <xacro:include filename="$(find tobas_description)/urdf/components/fmu/tobas_t1.xacro"/>
  <xacro:include filename="$(find tobas_description)/urdf/components/battery/hrb_4s_5000mah_50c.xacro"/>
  <xacro:include filename="$(find tobas_description)/urdf/components/propeller/phantom3_0945.xacro"/>

  <!-- Properties -->
  <xacro:property name="frame_radius" value="0.294"/>
  <xacro:property name="frame_height" value="0.056"/>
  <xacro:property name="frame_mass" value="0.916217"/>
  <xacro:property name="propeller_offset" value="0.275"/>

  <!-- Base Link -->
  <link name="base_link"/>

  <!-- Frame -->
  <joint name="frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="frame"/>
  </joint>
  <link name="frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tobas_description/meshes/f550/frame.stl" scale="1 1 1"/>
      </geometry>
      <xacro:insert_block name="black"/>
    </visual>
    <xacro:hexagonal_prism_collision side="${frame_radius}" height="${frame_height}" x0="0" y0="0" z0="${-frame_height/2}"/>
    <inertial>
      <mass value="${frame_mass}"/>
      <origin xyz="0 0 -6.031e-3" rpy="0 0 0"/>
      <inertia ixx="1.953e-2" ixy="-2.894e-6" ixz="2.258e-6" iyy="1.953e-2" iyz="3.192e-6" izz="3.837e-2"/>
    </inertial>
  </link>

  <!-- Flight Controller -->
  <xacro:tobas_t1 parent="base_link">
    <origin xyz="0 0 0.020" rpy="0 0 0"/>
  </xacro:tobas_t1>

  <!-- Battery -->
  <xacro:hrb_4s_5000mah_50c parent="base_link">
    <origin xyz="0 0 -0.021" rpy="0 0 0"/>
  </xacro:hrb_4s_5000mah_50c>

  <!-- Propellers -->
  <xacro:macro name="propeller" params="index direction yaw_deg">
    <xacro:phantom3_0945 parent="base_link" index="${index}" direction="${direction}">
      <origin xyz="${propeller_offset*cos(yaw_deg*deg2rad)} ${propeller_offset*sin(yaw_deg*deg2rad)} 0.0247" rpy="0 0 ${yaw_deg*deg2rad}"/>
    </xacro:phantom3_0945>
  </xacro:macro>

  <xacro:propeller index="0" direction="ccw" yaw_deg="30"/>
  <xacro:propeller index="1" direction="cw" yaw_deg="90"/>
  <xacro:propeller index="2" direction="ccw" yaw_deg="150"/>
  <xacro:propeller index="3" direction="cw" yaw_deg="210"/>
  <xacro:propeller index="4" direction="ccw" yaw_deg="270"/>
  <xacro:propeller index="5" direction="cw" yaw_deg="330"/>

</robot>
