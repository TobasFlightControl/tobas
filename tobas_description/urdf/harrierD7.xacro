<?xml version="1.0"?>

<robot name="harrier" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Properties  -->
  <xacro:property name="namespace" value="harrier" />
  <xacro:property name="use_mesh_file" value="true" />
  <xacro:property name="mesh_file" value="package://tobas_description/meshes/harrier/HarrierD7_reduced.stl" />
  <xacro:property name="mass" value="14.7" /> <!-- [kg] -->
  <xacro:property name="body_width" value="0.4" /> <!-- [m] -->
  <xacro:property name="body_height" value="0.12" /> <!-- [m] -->
  <xacro:property name="mass_rotor" value="0.01" /> <!-- [kg] -->
  <xacro:property name="xarm_length" value="0.534" /> <!-- [m] -->
  <xacro:property name="yarm_length" value="0.574" /> <!-- [m] -->
  <xacro:property name="rotor_offset_top" value="0.04" /> <!-- [m] -->
  <xacro:property name="radius_rotor" value="0.45" /> <!-- [m] -->

  <!-- Property Blocks -->
  <xacro:property name="body_inertia">
    <inertia ixx="1.57" ixy="0.0" ixz="0.0" iyy="3.93" iyz="0.0" izz="2.59" /> <!-- [kg m^2] -->
  </xacro:property>

  <!-- inertia of a single rotor, assuming it is a cuboid. Height=3mm, width=15mm -->
  <xacro:property name="rotor_inertia">
    <xacro:box_inertia x="${radius_rotor}" y="0.1" z="0.003" mass="${mass_rotor}" />
  </xacro:property>

  <!-- Included URDF Files. It requires some properties defined beforehand. -->
  <xacro:include filename="$(find tobas_description)/urdf/components/harrier/multirotor_base_harrier.xacro" />

  <!-- Instantiate multirotor_base_macro once -->
  <xacro:multirotor_base_macro
    robot_namespace="${namespace}"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    use_mesh_file="${use_mesh_file}"
    mesh_file="${mesh_file}">
    <xacro:insert_block name="body_inertia" />
  </xacro:multirotor_base_macro>

  <!-- Instantiate rotors -->
  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="cw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="0">
    <origin xyz="${xarm_length} -${yarm_length} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>
  
  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="ccw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="4">
    <origin xyz="${xarm_length} -${yarm_length} -${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="ccw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="1">
    <origin xyz="${xarm_length} ${yarm_length} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>
  
  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="cw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="5">
    <origin xyz="${xarm_length} ${yarm_length} -${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="cw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="2">
    <origin xyz="-${xarm_length} ${yarm_length} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="ccw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="6">
    <origin xyz="-${xarm_length} ${yarm_length} -${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>

  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="ccw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="3">
    <origin xyz="-${xarm_length} -${yarm_length} ${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>
  
  <xacro:vertical_rotor
    robot_namespace="${namespace}"
    direction="cw"
    parent="${namespace}/base_link"
    mass_rotor="${mass_rotor}"
    radius_rotor="${radius_rotor}"
    motor_number="7">
    <origin xyz="-${xarm_length} -${yarm_length} -${rotor_offset_top}" rpy="0 0 0" />
    <xacro:insert_block name="rotor_inertia" />
  </xacro:vertical_rotor>
  
</robot>
