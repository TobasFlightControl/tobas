<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find tobas_description)/urdf/components/battery/base.xacro"/>

  <xacro:macro name="sigp_3s_2250mah_60c" params="parent *origin">
    <xacro:base_lipo parent="${parent}" x="0.107" y="0.035" z="0.028" mass="0.201">
      <xacro:insert_block name="origin"/>
      <xacro:insert_block name="blue"/>
    </xacro:base_lipo>
  </xacro:macro>

</robot>
