<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Gazebo Reference macro -->
  <xacro:macro name="RefLink" params="ref">
    <gazebo reference="${ref}">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>30.0</mu1>
      <mu2>30.0</mu2>
      <maxVel>1.0</maxVel>
      <minDepth>0.001</minDepth>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <!-- Link1 -->
  <RefLink ref="rmx52/link1"/>

  <!-- Link2 -->
  <RefLink ref="rmx52/link2"/>

  <!-- Link3 -->
  <RefLink ref="rmx52/link3"/>

  <!-- Link4 -->
  <RefLink ref="rmx52/link4"/>

  <!-- Link5 -->
  <RefLink ref="rmx52/link5"/>

  <!-- gripper_link -->
  <RefLink ref="rmx52/gripper_link"/>

  <!-- gripper_link_sub -->
  <RefLink ref="rmx52/gripper_link_sub"/>

  <!-- end effector link -->
  <gazebo reference="rmx52/end_effector_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- loading plugin: mimic joints works in gazebo now -->
  <gazebo>
    <plugin name="gazebo_gripper_ros_control" filename="libroboticsgroup_gazebo_mimic_joint_plugin.so">
      <joint>rmx52/gripper</joint>
      <mimicJoint>rmx52/gripper_sub</mimicJoint>
      <multiplier>1.0</multiplier>
      <offset>0.0</offset>
    </plugin>
  </gazebo>

</robot>
