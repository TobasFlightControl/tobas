<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find tobas_description)/urdf/components/common.xacro"/>

  <xacro:macro name="phantom3_0945" params="parent index direction *origin">

    <xacro:property name="diameter" value="${9*inch2meter}"/>
    <xacro:property name="radius" value="${diameter/2}"/>
    <xacro:property name="height" value="0.012"/>
    <xacro:property name="mass" value="0.011"/>

    <xacro:property name="link_name" value="propeller_${index}"/>
    <xacro:property name="joint_name" value="${link_name}_joint"/>

    <joint name="${joint_name}" type="continuous">
      <xacro:insert_block name="origin"/>
      <axis xyz="0 0 1"/>
      <parent link="${parent}"/>
      <child link="${link_name}"/>
    </joint>

    <link name="${link_name}">
      <visual>
        <geometry>
          <mesh filename="package://tobas_description/meshes/common/propeller/phantom3_0945_${direction}.stl" scale="1e-3 1e-3 1e-3"/>
        </geometry>
        <xacro:insert_block name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${height/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 ${height/2}" rpy="0 0 0"/>
        <xacro:cylinder_inertia radius="${radius}" length="${height}" mass="${mass}"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
