<?xml version="1.0"?>

<robot name="f550_np"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Included URDF Files -->
  <xacro:include filename="$(find tobas_description)/urdf/components/multirotor_base.xacro"/>
  <xacro:include filename="$(find tobas_description)/urdf/components/battery/hrb_4s_5000mah_50c.xacro"/>
  <xacro:include filename="$(find tobas_description)/urdf/components/propeller/phantom3_0945.xacro"/>

  <!-- Properties -->
  <xacro:property name="frame_radius" value="0.294"/>
  <xacro:property name="frame_height" value="0.056"/>
  <xacro:property name="frame_mass" value="1.423"/>
  <xacro:property name="propeller_origin_z" value="0.060597"/>
  <xacro:property name="rotor_tilt" value="${30*deg2rad}"/>

  <!-- Base Link -->
  <link name="base_link"/>

  <!-- Frame -->
  <joint name="frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="frame"/>
  </joint>
  <link name="frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tobas_description/meshes/f550_np/frame.stl" scale="1e-3 1e-3 1e-3"/>
      </geometry>
      <xacro:insert_block name="black"/>
    </visual>
    <inertial>
      <mass value="${frame_mass}"/>
      <origin xyz="0.624e-3 1.181e-3 14.463e-3" rpy="0 0 0"/>
      <inertia ixx="3.692e-2" ixy="1.71388e-7" ixz="-2.219266e-6" iyy="3.681e-2" iyz="-5.1639988e-5" izz="7.082e-2"/>
    </inertial>
    <xacro:hexagonal_prism_collision side="${frame_radius}" height="${frame_height}" x0="0" y0="0" z0="${-frame_height/2}"/>
  </link>

  <!-- Battery -->
  <xacro:hrb_4s_5000mah_50c parent="base_link">
    <origin xyz="0 0 -0.021" rpy="0 0 0"/>
  </xacro:hrb_4s_5000mah_50c>

  <!-- Propellers -->
  <xacro:phantom3_0945 parent="base_link" index="0" direction="ccw">
    <origin xyz="0.242082 0.130702 ${propeller_origin_z}" rpy="${rotor_tilt} 0 ${30*deg2rad}"/>
  </xacro:phantom3_0945>
  <xacro:phantom3_0945 parent="base_link" index="1" direction="cw">
    <origin xyz="-0.007851 0.27500 ${propeller_origin_z}" rpy="${-rotor_tilt} 0 ${90*deg2rad}"/>
  </xacro:phantom3_0945>
  <xacro:phantom3_0945 parent="base_link" index="2" direction="ccw">
    <origin xyz="-0.234232 0.144298 ${propeller_origin_z}" rpy="${rotor_tilt} 0 ${150*deg2rad}"/>
  </xacro:phantom3_0945>
  <xacro:phantom3_0945 parent="base_link" index="3" direction="cw">
    <origin xyz="-0.234232 -0.144645 ${propeller_origin_z}" rpy="${-rotor_tilt} 0 ${210*deg2rad}"/>
  </xacro:phantom3_0945>
  <xacro:phantom3_0945 parent="base_link" index="4" direction="ccw">
    <origin xyz="-0.007851 -0.27500 ${propeller_origin_z}" rpy="${rotor_tilt} 0 ${270*deg2rad}"/>
  </xacro:phantom3_0945>
  <xacro:phantom3_0945 parent="base_link" index="5" direction="cw">
    <origin xyz="0.242082 -0.130355 ${propeller_origin_z}" rpy="${-rotor_tilt} 0 ${330*deg2rad}"/>
  </xacro:phantom3_0945>

</robot>
