<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <library_geometries>
    <geometry id="tiny_cube">
      <mesh>
        <source id="tiny_cube_positions">
          <float_array id="tiny_cube_positions_array" count="24">
            -1e-9 -1e-9 1e-9 1e-9 -1e-9 1e-9 1e-9 1e-9 1e-9 -1e-9 1e-9 1e-9 -1e-9 -1e-9 -1e-9 1e-9 -1e-9 -1e-9 1e-9 1e-9 -1e-9 -1e-9 1e-9 -1e-9
          </float_array>
          <technique_common>
            <accessor source="#tiny_cube_positions_array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="tiny_cube_vertices">
          <input semantic="POSITION" source="#tiny_cube_positions"/>
        </vertices>
        <polylist count="6">
          <input semantic="VERTEX" source="#tiny_cube_vertices" offset="0"/>
          <vcount>4 4 4 4 4 4</vcount>
          <p>0 1 2 3 4 5 6 7 0 3 7 4 1 5 6 2 0 4 5 1 3 2 6 7</p>
        </polylist>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="tiny_cube_scene">
      <node id="tiny_cube_node">
        <instance_geometry url="#tiny_cube">
          <bind_material>
            <technique_common>
              <material>
                <color>1 1 1 1</color>
              </material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#tiny_cube_scene"/>
  </scene>
</COLLADA>
