#!/bin/bash

set -e

# Show usage.
if [ $# -eq 0 ]; then
  echo "Usage: $(basename "$0") <host>" >&2
  exit 1
fi

# Check OS.
source /etc/os-release
if [[ "$ID" != "ubuntu" ]]; then
  echo "This script requires Ubuntu." >&2
  exit 1
fi

# Navigate to the repository root.
script_dir=$(dirname "$(realpath "$0")")
cd "${script_dir}/.."

# Sync packages..
dest_dir="/home/pi/colcon_ws/src/tobas"
rsync -rcmv --relative --delete \
  --rsync-path="mkdir -p ${dest_dir} && rsync" \
  src/tobas src/tobas_core tools \
  LICENSE LICENSES THIRD_PARTY_NOTICES.txt \
  --exclude-from .gitignore \
  --exclude .git/ \
  --exclude tobas_cui/ \
  --exclude tobas_description/ \
  pi@"$1":${dest_dir}/
