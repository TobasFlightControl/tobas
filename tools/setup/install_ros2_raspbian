#!/bin/bash

# Build ROS 2 Lyrical on Raspberry Pi OS Trixie (Debian 13).
# Ref. https://github.com/ros2/ros2_documentation/blob/lyrical/source/Get-Started/Installation/Alternatives/Ubuntu-Development-Setup.rst

set -eo pipefail

# Lyrical targets Debian Trixie; Bookworm has an older Python version.
source /etc/os-release
if [[ "$ID" != "debian" && "$ID" != "raspbian" ]] || [[ "$VERSION_CODENAME" != "trixie" ]]; then
  echo "ROS 2 Lyrical requires Raspberry Pi OS Trixie (Debian 13)." >&2
  exit 1
fi

# Set the locale for this script and child processes using Debian's built-in C.UTF-8.
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
if [ "$(locale charmap)" != "UTF-8" ]; then
  echo "The C.UTF-8 locale is not available." >&2
  exit 1
fi

# Enable required repositories
sudo apt update
sudo apt install -y ca-certificates curl python3
ros_apt_source_version=$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest |
  python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"])')
curl -fsSL -o /tmp/ros2-apt-source.deb \
  "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ros_apt_source_version}/ros2-apt-source_${ros_apt_source_version}.${VERSION_CODENAME}_all.deb"
sudo rm -f /etc/apt/sources.list.d/ros2.list # Replace the repository entry written by older versions of this script.
sudo dpkg -i /tmp/ros2-apt-source.deb
sudo apt update
sudo apt upgrade -y

# Install development tools
sudo apt install -y \
  ros-dev-tools \
  python3-colcon-common-extensions \
  python3-colcon-clean \
  python3-vcstool \
  python3-rosinstall-generator \
  python3-osrf-pycommon

# Delete all old source files to update everything to the latest version
sudo rm -rf ~/colcon_ws_install/src/

# Get ROS 2 source code
mkdir -p ~/colcon_ws_install/src
cd ~/colcon_ws_install
vcs import --input https://raw.githubusercontent.com/ros2/ros2/lyrical/ros2.repos ./src

# Get MAVLink's generated headers from its Lyrical release repository.
rosinstall_generator --rosdistro lyrical --format repos mavlink >mavlink.repos
vcs import src <mavlink.repos

# Get additional packages and their ROS dependencies at Lyrical release tags.
# Exclude packages already imported from ros2.repos and mavlink.repos.
rosinstall_generator --rosdistro lyrical --format repos --upstream --deps \
  xacro \
  dynamixel_sdk \
  ffmpeg_encoder_decoder \
  ffmpeg_image_transport_msgs \
  vision_opencv \
  geographic_info \
  diagnostics \
  mavros \
  --exclude-path src >additional.repos
vcs import src <additional.repos

# Install dependencies
if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then
  sudo rosdep init
fi
rosdep update --rosdistro lyrical
rosdep install -iy \
  --from-paths ~/colcon_ws_install/src \
  --rosdistro lyrical \
  --os=debian:trixie \
  --skip-keys "fastcdr rti-connext-dds-7.7.0 urdfdom_headers"

# Install MAVROS GeographicLib datasets after its system dependencies.
sudo ./src/mavros/mavros/scripts/install_geographiclib_datasets.sh

# Build and install
cd ~/colcon_ws_install/
# ROS_PYTHON_VERSION is required by MAVLink.
sudo \
  env \
  ROS_PYTHON_VERSION=3 \
  colcon build \
  --merge-install \
  --parallel-workers "$(nproc)" \
  --install-base /opt/ros/lyrical \
  --cmake-args \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_FLAGS="-mcpu=native" \
  -DCMAKE_CXX_FLAGS="-mcpu=native" \
  -DTRACETOOLS_DISABLED=ON

# Verify installation is successful
source /opt/ros/lyrical/setup.bash
echo -e "\033[32mROS 2 Lyrical has been installed successfully.\033[0m"
