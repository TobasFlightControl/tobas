[Unit]
Description=Low Priority Nodelet Manager
Requires=tobas_roscore.service
After=tobas_roscore.service
PartOf=tobas_nodelet_managers.target

[Service]
Type=simple
EnvironmentFile=/etc/tobas/common.env
EnvironmentFile=/etc/tobas/config_pkg.env
ExecStartPre=/etc/tobas/wait_for_rosmaster.sh
ExecStart=/bin/bash -c 'source /opt/ros/noetic/setup.bash && source /opt/tobas/setup.bash && source /etc/tobas/catkin_ws/devel/setup.bash && /opt/ros/noetic/bin/roslaunch ${TOBAS_CONFIG_PKG} nodelet_manager_low.launch'
Restart=always
RestartSec=5
CPUSchedulingPolicy=rr
CPUSchedulingPriority=10

[Install]
WantedBy=multi-user.target
