#!/bin/bash

# Get build type
DEFAULT_BUILD_TYPE="Release"
BUILD_TYPE=${1:-$DEFAULT_BUILD_TYPE}

# Check build type
if [ "$BUILD_TYPE" != "Release" ] && [ "$BUILD_TYPE" != "Debug" ]; then
  echo "Invalid build type: $BUILD_TYPE"
  echo "Usage: $0 {Release|Debug}"
  exit 1
fi

# Build & Install
sudo systemctl stop tobas_main.target &&
cd ~/catkin_ws/ &&
vcs pull &&
catkin build tobas -j4 -DCMAKE_BUILD_TYPE=$BUILD_TYPE &&
sudo rm -rf /opt/tobas &&
sudo cp -r ~/catkin_ws/install/ /opt/tobas/ &&
sudo systemctl start tobas_main.target &&

echo -e "\033[32mInstallation finished successfully.\033[0m"
