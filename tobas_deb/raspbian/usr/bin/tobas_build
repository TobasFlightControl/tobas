#!/bin/bash

sudo systemctl stop tobas_real.service &&
cd ~/catkin_ws/ &&
vcs pull &&
catkin build tobas -j4 -DCMAKE_BUILD_TYPE=Release &&
sudo rm -rf /opt/tobas &&
sudo cp -r ~/catkin_ws/install/ /opt/tobas/ &&
sudo systemctl restart tobas_real.service &&

echo -e "\033[32mFinished successfully.\033[0m"
