#!/bin/bash

# Build and install Tobas
tobas_build Release &&

# Remove unnecessary files
sudo rm -rf /tmp/* &&
sudo rm -rf /var/tmp/* &&
sudo rm -rf /var/log/* &&
rm -rf ~/.cache/* &&
rm -rf ~/.emacs.d/* &&
rm -rf ~/.vscode-server/* &&

# Remove personal information
rm -rf ~/.gnupg/* &&
rm -rf ~/.ssh/* &&

# Clean ROS
rosclean purge -y &&

# Clean catkin workspaces
cd ~/catkin_ws/ &&
catkin clean -y &&
rm -rf ./src/* &&
cd /etc/tobas/catkin_ws/ &&
sudo catkin clean -y &&
sudo rm -rf ./src/* &&

# Clear configuration file
sudo truncate -s 0 /etc/tobas/config.ini &&

# Clear network settings
sudo sed -i '4,$ d' /etc/wpa_supplicant/wpa_supplicant.conf &&

echo -e "\033[32mFinished successfully.\033[0m"
