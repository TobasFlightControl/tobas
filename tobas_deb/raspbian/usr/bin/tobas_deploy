#!/bin/bash

# Build and install Tobas
sudo systemctl stop tobas_roscore.service &&
cd ~/catkin_ws/ &&
vcs pull &&
catkin build tobas -j4 -DCMAKE_BUILD_TYPE=Release &&
sudo rm -rf /opt/tobas &&
sudo cp -r ~/catkin_ws/install/ /opt/tobas/ &&

# Update and clean apt packages
sudo apt update &&
sudo apt upgrade -y  &&
sudo apt autoremove --purge -y &&
sudo apt clean &&

# Remove unnecessary files
sudo rm -rf /tmp/* &&
sudo rm -rf /var/tmp/* &&
sudo rm -rf /var/log/* &&
rm -rf ~/.cache/* &&
rm -rf ~/.emacs.d/* &&
rm -rf ~/.vscode-server/* &&

# Remove personal information
rm -rf ~/.gnupg/ &&
rm -rf ~/.ssh/ &&

# Remove configuration file
sudo rm /etc/tobas/config.ini &&

# Clean ROS
rosclean purge -y &&

# Clean catkin workspaces
cd ~/catkin_ws/ &&
catkin clean -y &&
rm -rf ./src/* &&
cd /etc/tobas/catkin_ws/ &&
sudo catkin clean -y &&
sudo rm -rf ./src/* &&

echo -e "\033[32mFinished successfully.\033[0m"
