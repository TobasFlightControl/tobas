[Unit]
Description=Tobas Realtime Process
PartOf=tobas_real.target

[Service]
Type=simple
EnvironmentFile=/etc/tobas/common.env
EnvironmentFile=/etc/tobas/config/project.env
Environment="ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST"
Environment="CYCLONEDDS_URI=/etc/tobas/config/cyclonedds_realtime.xml"
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /opt/tobas/local_setup.bash && source /etc/tobas/colcon_ws/install/local_setup.bash && /opt/ros/jazzy/bin/ros2 launch ${TOBAS_CONFIG_PKG} real_realtime.launch.py'
Restart=no
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20
# Start the parent process on a single CPU to prevent memory contention between component managers.
CPUAffinity=0

[Install]
WantedBy=multi-user.target
