# cf. [Linuxの新しい起動オプション設定機能 Bootconfigの話](https://qiita.com/mhiramat/items/8285e87133a338b18b63)
# cf. [リアルタイム性能の測定に向けたRaspberryPi3のセットアップ](https://wazalabo.com/ros2_raspberrypi3_setup.html)
# cf. [DPDKのパケットロスを抑制する](https://www.miraclelinux.com/tech-blog/0f7a6b)

kernel {
  # Disable the serial console
  console = tty1

  # Avoid dependency on a specific PARTUUID
  root = /dev/mmcblk0p2

  rootfstype = ext4

  fsck.repair = yes

  rootwait

  cfg80211.ieee80211_regdom = JP

  # Disable FIQ interrupts
  dwc_otg {
    fiq_fsm_enable = 0
    fiq_enable = 0
    nak_holdoff = 0
    speed = 1
  }

  # Avoid RCU (Read-Copy-Update) to be executed on CPU1-3
  rcu_nocbs = 1-3

  # Avoid periodical timer interruption to be executed on CPU1-3
  nohz_full = 1-3

  # Isolate CPU1-3
  isolcpus = 1-3
}
