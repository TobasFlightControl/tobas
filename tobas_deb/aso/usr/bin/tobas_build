#!/bin/bash

# Get build type
DEFAULT_BUILD_TYPE="Release"
BUILD_TYPE=${1:-$DEFAULT_BUILD_TYPE}

# Check build type
if [ "$BUILD_TYPE" != "Release" ] && [ "$BUILD_TYPE" != "Debug" ]; then
  echo "Invalid build type: $BUILD_TYPE"
  echo "Usage: $0 {Release|Debug}"
  exit 1
fi

# Build & Install
sudo systemctl stop tobas_real.service &&
cd ~/colcon_ws/ &&
vcs pull &&
colcon build --packages-up-to tobas --parallel-workers $(nproc) --install-base ${UBUNTU_WS}/opt/tobas --build-base ~/colcon_ws/build --cmake-args -DCMAKE_BUILD_TYPE=$BUILD_TYPE &&
sudo rm -rf /opt/tobas &&
sudo cp -r ~/colcon_ws/install/ /opt/tobas/ &&
sudo systemctl start tobas_real.service &&

echo -e "\033[32mInstallation finished successfully.\033[0m"
