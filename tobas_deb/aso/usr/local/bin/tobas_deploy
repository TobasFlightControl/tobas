#!/bin/bash

# Install Tobas
cd ~/colcon_ws &&
colcon build  --cmake-clean-first --parallel-workers $(nproc) --install-base /opt/tobas --build-base ~/colcon_ws/release_build --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-up-to tobas &&

# Remove unnecessary files
sudo rm -rf /tmp/* &&
sudo rm -rf /var/tmp/* &&
sudo rm -rf /var/log/* &&
rm -rf ~/.cache/* &&
rm -rf ~/.emacs.d/* &&
rm -rf ~/.vscode-server/* &&
rm -rf ~/.ros/*

# Remove personal information
rm -rf ~/.gnupg/* &&
rm -rf ~/.ssh/* &&

# Clean colcon workspaces
cd ~/colcon_ws/ &&
colcon clean workspace -y &&
rm -rf ./src/* &&
cd /etc/tobas/colcon_ws/ &&
sudo colcon clean workspace -y &&
sudo rm -rf ./src/* &&

# Clear network settings
sudo sed -i '4,$ d' /etc/wpa_supplicant/wpa_supplicant.conf &&

echo -e "\033[32mFinished successfully.\033[0m"
